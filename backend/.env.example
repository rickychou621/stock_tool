# 本機開發用(不透過docker-compose時)，複製成 .env 使用。
# docker-compose 實際運行時是讀 config/backend.env，這裡的值僅供本機開發參考，兩邊變數名稱需一致。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_tool
DB_USER=stock_tool
DB_PASSWORD=changeme_backend_password

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

FINMIND_API_TOKEN=
BROKER_API_KEY=
BROKER_API_SECRET=

SCREENING_INTERVAL_MINUTES=5
CANDIDATE_POOL_LIMIT=10
