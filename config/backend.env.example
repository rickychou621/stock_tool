DB_HOST=db
DB_PORT=3306
DB_NAME=stock_tool
DB_USER=stock_tool
DB_PASSWORD=changeme_backend_password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FINMIND_API_TOKEN=
BROKER_API_KEY=
BROKER_API_SECRET=
SCREENING_INTERVAL_MINUTES=5
CANDIDATE_POOL_LIMIT=10

# Single backend process / replica. FinMind dividend budget: 240 requests/hour.
MARKET_SCAN_WORKERS=5
FINMIND_SCAN_REQUESTS_PER_MINUTE=4

# All TWSE endpoints (including ISIN and trading calendars) share this interval.
TWSE_MIN_REQUEST_INTERVAL_SECONDS=3

# Stage 4 C: proportional trading costs, saved with each backtest.
TRADE_FEE_RATE=0.001425
TRADE_FEE_DISCOUNT=1.0
TRADE_TAX_RATE_STOCK=0.003
TRADE_TAX_RATE_ETF=0.001
# 訊號追蹤觀察期：逗號分隔，1～60 個交易日；只影響新訊號
SIGNAL_TRACKING_HORIZONS=1,5,10,20

# 全市場 Telegram 最低成交金額（元）：有限且 ≥ 0；0 不過濾
MARKET_SCAN_NOTIFY_MIN_TURNOVER=10000000
